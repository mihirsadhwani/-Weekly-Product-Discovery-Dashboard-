GEMINI_API_KEY=your_key_here
# Optional. Defaults to gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# Optional. Fine-grained GitHub token with Actions: read/write on this repo. Lets the Refresh button
# start the live Flipkart price pipeline. Without it the button only reloads published data.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=owner/repo
